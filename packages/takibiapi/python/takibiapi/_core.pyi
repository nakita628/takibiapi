# Types of the Rust extension (core/src/lib.rs). Functions return None for input whose result
# they cannot reproduce exactly; the caller then uses Python's json / urllib.parse.
from collections.abc import Callable
from typing import Any

class Validator:
    """A type compiled from ``takibiapi.schema.plan(tp)``."""

    def __init__(self, plan: dict[str, Any]) -> None: ...
    def decode(self, value: Any, coerce: bool) -> tuple[bool, Any]: ...
    def decode_json(self, data: bytes) -> tuple[bool, Any] | None: ...

class Router:
    """takibiapi.router.Router in Rust."""

    def add(self, method: str, path: str, entry: Any) -> None: ...
    def match(self, method: str, path: str) -> tuple[Any, dict[str, str]] | None: ...
    def allowed(self, path: str) -> list[str]: ...

def dumps(value: Any, default: Callable[[Any], Any] | None = None) -> bytes | None: ...
def loads(data: bytes) -> tuple[Any] | None: ...
def parse_query(qs: bytes) -> dict[str, list[str]] | None: ...
